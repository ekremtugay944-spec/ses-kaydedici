# Gözde Plastik Hatırlatma Botu v2.2 - Ortam Değişkenleri
# Bu dosyayı .env olarak kopyala ve gerçek değerleri yaz
# (.env GIT'E GITMEZ, .gitignore tarafından dışlanır)

# ============================================================
# ZORUNLU
# ============================================================

# Telegram Bot Token (BotFather'dan al)
TELEGRAM_BOT_TOKEN=BURAYA_BOTFATHER_TOKEN_YAZ

# Yetkili Chat ID'ler (virgülle ayır, kendi ID'ini öğrenmek için bota /start yaz)
AUTHORIZED_CHAT_IDS=123456789

# ============================================================
# OPSİYONEL - MODEL AYARLARI
# ============================================================

# Whisper model (tiny / base / small / medium / large-v3)
WHISPER_MODEL=small

# Ollama model
OLLAMA_MODEL=qwen2.5:7b

# ============================================================
# OPSİYONEL - HAIKU (Şu an KAPALI)
# Açmak istersen USE_HAIKU=true yap ve API key ekle
# ============================================================
USE_HAIKU=false
ANTHROPIC_API_KEY=
HAIKU_MODEL=claude-haiku-4-5
HAIKU_USE_FOR_RISK_ANALYSIS=true

# ============================================================
# OPSİYONEL - TATİL/HAFTA SONU ERTELEME
# Hatırlatma cumartesi/pazara veya tatile düşerse Pazartesi'ye al
# ============================================================
SKIP_WEEKENDS=false
SKIP_TURKEY_HOLIDAYS=false

# ============================================================
# OPSİYONEL - APPLE REMINDERS
# ============================================================
APPLE_REMINDERS_CLI=/opt/homebrew/bin/reminders
